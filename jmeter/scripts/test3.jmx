              <stringProp name="script">import java.util.concurrent.ConcurrentHashMap

// Используем putIfAbsent для атомарной инициализации
def users = props.get(&quot;users&quot;)
if (users == null) {
    props.putIfAbsent(&quot;users&quot;, new ConcurrentHashMap())
    users = props.get(&quot;users&quot;)
}

def userId = vars.get(&quot;user_id&quot;)
def token = vars.get(&quot;token&quot;)

// Сохраняем текущего пользователя
if (userId &amp;&amp; token) {
    users.put(userId, token)
}

// Выбор рандомного пользователя (с проверкой на пустоту)
if (!users.isEmpty()) {
    def keys = new ArrayList(users.keySet())
