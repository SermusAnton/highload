            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Set random to_user " enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.util.concurrent.ConcurrentHashMap

// Используем putIfAbsent для атомарной инициализации
def users = props.get(&quot;users&quot;)
if (users == null) {
    props.putIfAbsent(&quot;users&quot;, new ConcurrentHashMap())
    users = props.get(&quot;users&quot;)
}

def userId = vars.get(&quot;user_id&quot;)
def token = vars.get(&quot;token&quot;)

// Сохраняем текущего пользователя
if (userId &amp;&amp; token) {
    users.put(userId, token)
}

// Выбор рандомного пользователя (с проверкой на пустоту)
if (!users.isEmpty()) {
    def keys = new ArrayList(users.keySet())
    def randomUserId = keys[new Random().nextInt(keys.size())]
    
    vars.put(&quot;to_user&quot;, randomUserId.toString()) 
    vars.put(&quot;token_to_user&quot;, users.get(randomUserId).toString())
    
    log.info(&quot;Total users in map: ${users.size()}. Selected: ${randomUserId}&quot;)
} else {
    log.warn(&quot;Users map is empty!&quot;)
}</stringProp>
            </JSR223PostProcessor>
